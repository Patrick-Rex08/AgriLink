# ==============================================================================
# AgriLink Environment Variables Template
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
PROJECT_NAME="AgriLink API"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=agrilink

# Optional: Complete Database URL override (takes precedence if provided)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/agrilink

# Frontend Configuration (Used by Vite, prefixed with VITE_)
# Note: Vite only exposes variables prefixed with VITE_ to the browser client.
VITE_API_URL=http://localhost:8000/api/v1
