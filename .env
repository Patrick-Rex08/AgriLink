# ==============================================================================
# AgriLink Backend Environment Variables
# ==============================================================================

# Application Mode
ENVIRONMENT=development
PROJECT_NAME="AgriLink API"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Allowed Cross-Origin Origins (CORS)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=agrilink

# Optional: Direct Database URI
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/agrilink
